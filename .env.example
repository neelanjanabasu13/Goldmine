# GOOGLE_CLOUD_PROJECT: Required for Vertex AI client initialization.
GOOGLE_CLOUD_PROJECT=

# GEMINI_MODEL: Gemini model identifier (defaults to gemini-3.7-flash)
GEMINI_MODEL=gemini-3.7-flash

# MAPS_API_KEY: Google Maps / Places API key for Places Text Search (New)
MAPS_API_KEY=

# PORT: Server listening port (defaults to 8080)
PORT=8080

